# Copy to .env.deploy and fill in
# cp .env.deploy.example .env.deploy

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=

# Railway — REQUIRED for setup and deploy
# Project ID: Railway dashboard → Project → Settings → General
RAILWAY_PROJECT_ID=

# Project Token: Railway dashboard → Project → Settings → Tokens → Create Token
# (This is NOT the same as an account token from railway.com/account/tokens)
RAILWAY_TOKEN=

# Environment name (default: production)
# RAILWAY_ENVIRONMENT=production

# Optional — only needed if you want setup to create/link projects automatically
# Account Token: https://railway.com/account/tokens
# RAILWAY_API_TOKEN=
