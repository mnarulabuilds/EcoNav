# Copy to .env.deploy and fill in (one-time setup)
# cp .env.deploy.example .env.deploy

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=

# Railway — https://railway.com/account/tokens
RAILWAY_TOKEN=

# Optional: override defaults from deploy.config.json
# WEB_DOMAIN=www.econav.in
# API_DOMAIN=api.econav.in
# API_URL=https://api.econav.in
