# Copy to .env.deploy and fill in (one-time setup)
# cp .env.deploy.example .env.deploy

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=

# Railway PROJECT token (for npm run deploy)
# Railway dashboard → Project → Settings → Tokens → Create Token
RAILWAY_TOKEN=

# Railway ACCOUNT token (for npm run setup:deploy only — optional if project already linked)
# https://railway.com/account/tokens
# RAILWAY_API_TOKEN=

# Required when using RAILWAY_API_TOKEN instead of RAILWAY_TOKEN
# Railway dashboard → Project → Settings → General → Project ID
# RAILWAY_PROJECT_ID=
