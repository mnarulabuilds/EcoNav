# API Server
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development

# PostgreSQL (Phase 2 persistence — used when set; omit + PLATFORM_STORE=memory for in-memory only)
DATABASE_URL=postgres://cityconnect:cityconnect@localhost:5432/cityconnect
# PLATFORM_STORE=memory
NOTIFICATION_POLL_MS=15000

# Web App
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production: https://api.econav.in
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Route Planner Defaults
DEFAULT_VEHICLE_SPEED_KMH=40
DEFAULT_SERVICE_TIME_MINUTES=10
DEFAULT_COST_PER_KM=2.5
DEFAULT_COST_PER_HOUR=500

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Production (Docker): https://www.cityconnect.in,https://cityconnect.in — see .env.production.example

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001
