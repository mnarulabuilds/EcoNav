# Copy to .env.production and fill secrets before deploy:
#   cp .env.production.example .env.production

# ── Public URLs (must match DNS + TLS certificates) ───────────────────────────
PUBLIC_WEB_DOMAIN=www.cityconnect.in
PUBLIC_WEB_ALIAS=cityconnect.in
PUBLIC_API_DOMAIN=api.cityconnect.in

NEXT_PUBLIC_API_URL=https://api.cityconnect.in
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Comma-separated browser origins allowed to call the API (include apex + www)
CORS_ORIGINS=https://www.cityconnect.in,https://cityconnect.in

# Set false in production Docker; true only if you still use Vercel previews
CORS_ALLOW_VERCEL=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cityconnect
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=cityconnect
DATABASE_URL=postgres://cityconnect:change-me-use-a-long-random-password@postgres:5432/cityconnect

# Let's Encrypt contact for Caddy
ACME_EMAIL=admin@cityconnect.in

NOTIFICATION_POLL_MS=15000

# ── Production hardening ──────────────────────────────────────────────────────
# Pilot: keep demo OTP. Set ALLOW_DEMO_OTP=false when SMS auth is integrated.
# Go-live: set false. Pilot on public DNS: keep true and set PREFLIGHT_ALLOW_DEMO_OTP=true for deploy scripts only.
ALLOW_DEMO_OTP=true
PREFLIGHT_ALLOW_DEMO_OTP=false
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=200
RATE_LIMIT_LOGIN_MAX=15
PG_POOL_MAX=25
API_BODY_LIMIT_BYTES=1048576

# ── Optional: remote deploy target (used by npm run deploy) ───────────────────
# DEPLOY_SSH=ubuntu@YOUR_SERVER_IP
# DEPLOY_PATH=/opt/cityconnect
