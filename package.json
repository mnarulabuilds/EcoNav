{
  "name": "cityconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CityConnect — smart city platform for citizens and municipal operations",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@econav/sdk && npm run build --workspaces --if-present",
    "prepare": "node scripts/prepare-husky.mjs",
    "dev": "bash scripts/dev-local.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bash scripts/with-env.sh npm run migrate --workspace=@econav/db",
    "db:seed": "bash scripts/with-env.sh npm run seed --workspace=@econav/db",
    "db:prepare": "npm run build --workspace=@econav/db && npm run db:seed",
    "dev:worker": "npm run worker:notifications --workspace=@econav/api",
    "dev:api": "npm run dev --workspace=@econav/api",
    "dev:web": "npm run dev --workspace=@econav/web",
    "dev:mobile": "npm run start --workspace=@econav/mobile",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "setup:deploy": "bash scripts/setup-docker-prod.sh",
    "deploy": "bash scripts/deploy-docker.sh",
    "deploy:live": "bash scripts/deploy-live.sh",
    "verify:live": "bash scripts/verify-live.sh",
    "preflight:production": "bash scripts/preflight-production.sh",
    "deploy:vercel": "bash scripts/legacy/deploy-vercel.sh",
    "go-live": "bash scripts/go-live.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@railway/cli": "^5.52.1",
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "vercel": "^41.0.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "eslint --max-warnings=0 -c apps/web/.eslintrc.json",
    "apps/api/**/*.ts": "eslint --max-warnings=0"
  }
}
