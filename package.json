{
  "name": "cityconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CityConnect — smart city platform for citizens and municipal operations",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "bash scripts/dev-local.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bash scripts/with-env.sh npm run migrate --workspace=@econav/db",
    "db:seed": "bash scripts/with-env.sh npm run seed --workspace=@econav/db",
    "db:prepare": "npm run build --workspace=@econav/db && npm run db:seed",
    "dev:worker": "npm run worker:notifications --workspace=@econav/api",
    "dev:api": "npm run dev --workspace=@econav/api",
    "dev:web": "npm run dev --workspace=@econav/web",
    "dev:mobile": "npm run start --workspace=@econav/mobile",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup:deploy": "bash scripts/setup-docker-prod.sh",
    "deploy": "bash scripts/deploy-docker.sh",
    "deploy:vercel": "bash scripts/legacy/deploy-vercel.sh",
    "go-live": "bash scripts/go-live.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@railway/cli": "^5.52.1",
    "vercel": "^41.0.0"
  }
}
